// ==UserScript==
// @name         Instagram Uno-Reverse Feed Filter (Full Intercept + Aggressive Bait Filters)
// @namespace    local
// @version      4.1.0
// @description  Intercepts IG network responses (fetch + XHR) and strips matched content before UI renders it.
// @match        https://www.instagram.com/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(() => {
  "use strict";

  /***********************************************************************
   * READ THIS FIRST (PLEASE, I AM BEGGING YOU)
   *
   * This script intercepts Instagram's JSON responses and edits them.
   * That means:
   *  - you're changing what the app *receives*
   *  - not just hiding elements after the fact
   *
   * If you don't understand fetch/XHR interception and JSON mutation:
   *  - do not modify anything except EXCLUDED_USERNAMES and maybe regex lists
   *  - do not "clean up" code you don't understand
   *
   * Humans love touching things and then acting surprised.
   ***********************************************************************/

  /**********************
   * DEBUG
   **********************/
  const DEBUG = false;
  const log = (...args) => { if (DEBUG) console.log("[IG UNO]", ...args); };

  /**********************
   * SAFE LIST (NEVER FILTER)
   **********************/
  const EXCLUDED_USERNAMES = new Set([
    "your_username_here",
  ].map(s => String(s).toLowerCase()));

  const normalize = (s) => String(s || "").trim().replace(/^@/, "").toLowerCase();
  const isExcluded = (u) => EXCLUDED_USERNAMES.has(normalize(u));

  /**********************
   * FILTERS
   * (Keep these targeted at spam/funnels; don't turn it into a word-ban grenade.)
   **********************/

  // Username/handle patterns: reliable, low false positives (usually).
  const USERNAME_REGEXES = [
    // "official" bait
    /(^|[._-])official($|[._-])/i,
    /\bofficial\b/i,

    // domains
    /\.com\b/i,
    /\.io\b/i,

    // selling / commerce
    /\bmarket\b/i,
    /\bshop\b/i,
    /\bstore\b/i,
    /\boutlet\b/i,
    /\bboutique\b/i,
    /\bbrand\b/i,
    /\bpromo\b/i,
    /\bsale(s)?\b/i,
    /\bdeal(s)?\b/i,
    /\bdiscount(s)?\b/i,
    /\bwholesale\b/i,
    /\bmerch\b/i,
    /\bproduct(s)?\b/i,
    /^eric_hexter$/i,

    // spam verticals
    /\bcrypto\b/i,
    /\bnft\b/i,
    /\bforex\b/i,
    /\bcasino\b/i,
    /\bbet(s|ting)?\b/i,
    /\bloan(s)?\b/i,
    /\bfinance\b/i,
    /\binvest(ing|ment)?\b/i,

    // fake law enforcement thirst/funnel pages
    /\bpolice\b/i,
    /\bcop(s)?\b/i,
    /\bsheriff\b/i,
    /\bdeputy\b/i,
    /\btrooper\b/i,
    /\bpatrol\b/i,
    /\bbadge\b/i,
    /\blaw[_-]?enforcement\b/i,
    /\bthin\s*blue\s*line\b/i,
  ];

  // Religious bait (caption/hashtags/bio-ish text that appears in feed payloads)
  const RELIGIOUS_REGEXES = [
    /\bchristian\b/i,
    /\bjesus\b/i,
    /\bgod\b/i,
    /\bblessed\b/i,
    /\bbible\b/i,
    /\bfaith\b/i,
    /\bprayer\b/i,
    /\bgospel\b/i,
    /\bchurch\b/i,
    /\bamen\b/i,
    /#christian\b/i,
    /#christiangirl\b/i,
    /#christianboy\b/i,
  ];

  // General engagement bait / funnel language (caption text)
  const BAIT_REGEXES = [
    /\blink in bio\b/i,
    /\bcheck (my|the) bio\b/i,
    /\bclick the link\b/i,
    /\bdm (me|us)\b/i,
    /\bmessage me\b/i,
    /\bcome find me\b/i,
    /\bwaiting for you\b/i,
    /\bplease stay\b/i,
    /\blose followers\b/i,
    /\bevery time i post\b/i,
    /\bi can'?t reply to everyone\b/i,
    /\bjoin my\b/i,
    /\bsupporters?\b/i,
    /\bcommunity\b/i,
    /\bexclusive\b/i,
    /\bsubscription\b/i,
    /\bsubscribe\b/i,
  ];

  // Identity + monetization funnel behavior (targets the *funnel*, not identity existing)
  // This is intentionally "AND-ish": transition keywords + money/CTA keywords together.
  const TRANSITION_WORDS = [
    /\btrans\b/i,
    /\btransgirl\b/i,
    /\btranswoman\b/i,
    /\btrans guy\b/i,
    /\btransman\b/i,
    /\bmtf\b/i,
    /\bftm\b/i,
    /\bhrt\b/i,
    /\bestrogen\b/i,
    /\btestosterone\b/i,
    /\btop surgery\b/i,
    /\bbottom surgery\b/i,
    /\bfacial feminization\b/i,
    /\bffs\b/i,
    /\btransition(ing|ed)?\b/i,
  ];

  const MONEY_CTA_WORDS = [
    /\blink in bio\b/i,
    /\bdm (me|us)\b/i,
    /\bsubscribe\b/i,
    /\bexclusive\b/i,
    /\bonlyfans\b/i,
    /\bof\b/i,
    /\bpatreon\b/i,
    /\bgofundme\b/i,
    /\bdonate\b/i,
    /\bfund\b/i,
    /\bcashapp\b/i,
    /\bvenmo\b/i,
    /\bpaypal\b/i,
    /\btips?\b/i,
  ];

  // Optional: extra funnel patterns common in thirst-bait captions
  const THIRST_FUNNEL_REGEXES = [
    /\bbefore (and|&) after\b/i,
    /\bglow up\b/i,
    /\bmy (journey|story)\b/i,
    /\bi'?m just a (girl|boy)\b/i,
    /\bstay\b.*🥺/i,
  ];

  function matchesAny(text, regexes) {
    const t = String(text || "");
    return regexes.some(rx => rx.test(t));
  }

  function matchesTransitionFunnel(captionText) {
    const t = String(captionText || "");
    const hasTransition = TRANSITION_WORDS.some(rx => rx.test(t));
    if (!hasTransition) return false;

    const hasMoneyCta = MONEY_CTA_WORDS.some(rx => rx.test(t));
    if (!hasMoneyCta) return false;

    // If both are present, we treat it as funnel bait.
    return true;
  }

  /**********************
   * CONTENT SIGNALS
   **********************/
  function shouldRemoveBySignals(username, caption) {
    if (!username || isExcluded(username)) return false;
    return matchesAny(username, USERNAME_REGEXES) ||
      matchesAny(caption, RELIGIOUS_REGEXES) ||
      matchesAny(caption, BAIT_REGEXES) ||
      matchesAny(caption, THIRST_FUNNEL_REGEXES) ||
      matchesTransitionFunnel(caption);
  }

  // Only inspect feed/explore/clip REST responses and GraphQL on this origin.
  // GraphQL shares its URL with settings, DMs, comments and mutations, so the
  // response must ALSO contain a recognized feed collection before we edit it.
  function endpointKind(input) {
    try {
      const url = new URL(typeof input === "string" ? input : input?.url || input,
        location.href);
      if (url.origin !== location.origin) return null;
      if (/^\/graphql(?:\/|$)/.test(url.pathname) || url.pathname === "/api/graphql") {
        return "graphql";
      }
      if (/^\/api\/v1\/feed\/(?:timeline|user\/[^/]+|tag\/[^/]+)\/?$/.test(url.pathname)) {
        return "feed";
      }
      if (/^\/api\/v1\/clips\/(?:discover|connected|user)\/?$/.test(url.pathname)) {
        return "clips";
      }
      if (/^\/api\/v1\/discover\/explore\/?$/.test(url.pathname)) return "explore";
    } catch {}
    return null;
  }

  function mediaFromItem(item) {
    // Unwrap only known feed envelopes. Do not mistake bare user/comment objects
    // for posts, and never recursively delete an owner or carousel child.
    let media = item;
    for (let i = 0; i < 4 && media && typeof media === "object"; i++) {
      const nested = media.node || media.media_or_ad || media.media || media.clip;
      if (!nested) break;
      media = nested;
    }
    if (!media || typeof media !== "object") return null;
    const hasId = media.id != null || media.pk != null || typeof media.code === "string" ||
      typeof media.shortcode === "string";
    const hasMediaShape = media.media_type != null || media.product_type != null ||
      media.image_versions2 != null || media.video_versions != null ||
      media.display_url != null || /^(?:GraphImage|GraphVideo|GraphSidecar)$/.test(media.__typename || "");
    return hasId && hasMediaShape ? media : null;
  }

  function shouldRemoveItem(item) {
    const media = mediaFromItem(item);
    if (!media) return false;
    const username = media.user?.username || media.owner?.username;
    const caption = typeof media.caption === "string" ? media.caption :
      media.caption?.text || media.edge_media_to_caption?.edges?.[0]?.node?.text || "";
    return shouldRemoveBySignals(username, caption);
  }

  function scrubJson(data, kind) {
    let changed = false;
    function filterCollection(container, key) {
      if (!Array.isArray(container?.[key])) return;
      const before = container[key];
      const after = before.filter(item => !shouldRemoveItem(item));
      if (after.length !== before.length) {
        container[key] = after;
        changed = true;
        log("Removed feed entries:", before.length - after.length);
      }
    }

    if (kind === "feed") {
      filterCollection(data, "feed_items");
      filterCollection(data, "items");
    } else if (kind === "clips") {
      filterCollection(data, "items");
    } else if (kind === "explore" && Array.isArray(data?.sectional_items)) {
      // Keep section/layout objects intact, including their pagination metadata.
      for (const section of data.sectional_items) {
        filterCollection(section?.layout_content, "medias");
        filterCollection(section?.layout_content, "fill_items");
        filterCollection(section?.layout_content, "one_by_two_item");
      }
    } else if (kind === "graphql") {
      // Explicit known media connections, not arbitrary arrays or user lists.
      const connectionName = /^(?:xdt_api__v1__(?:feed__(?:timeline|user|tag)|clips__(?:home|discover|connected|user))__connection|edge_web_feed_timeline|edge_owner_to_timeline_media|edge_hashtag_to_media)$/;
      const seen = new WeakSet();
      function walk(node) {
        if (!node || typeof node !== "object" || seen.has(node)) return;
        seen.add(node);
        for (const key of Object.keys(node)) {
          if (connectionName.test(key)) {
            filterCollection(node[key], "edges");
            // Do not inspect inside media or mutate nested owner/comment data.
          } else {
            walk(node[key]);
          }
        }
      }
      walk(data);
    }
    return changed;
  }

  function isJson(contentType) {
    return /(?:application\/(?:[\w.-]+\+)?json|text\/javascript)(?:\s*;|$)/i.test(contentType || "");
  }

  function filterText(text, kind) {
    // Instagram sometimes sends an anti-JSON-hijacking prefix. Keep it intact.
    const prefix = text.match(/^\s*for\s*\(;;\);\s*/)?.[0] || "";
    const json = JSON.parse(text.slice(prefix.length));
    return scrubJson(json, kind) ? prefix + JSON.stringify(json) : text;
  }

  /**********************
   * FETCH INTERCEPT
   **********************/
  const realFetch = window.fetch;

  function preserveResponseMetadata(response, original) {
    for (const key of ["url", "redirected", "type"]) {
      Object.defineProperty(response, key, { value: original[key], configurable: true });
    }
    const clone = response.clone;
    Object.defineProperty(response, "clone", {
      value() { return preserveResponseMetadata(clone.call(this), original); },
      configurable: true,
    });
    return response;
  }

  window.fetch = async function(input) {
    const response = await realFetch.apply(this, arguments);
    const kind = endpointKind(input);
    if (!kind || !response.ok || !isJson(response.headers.get("content-type"))) return response;
    try {
      const text = await response.clone().text();
      const filtered = filterText(text, kind);
      if (filtered === text) return response;
      const headers = new Headers(response.headers);
      // The browser already decoded the body; these describe the old wire bytes.
      headers.delete("content-length");
      headers.delete("content-encoding");
      return preserveResponseMetadata(new Response(filtered, {
        status: response.status,
        statusText: response.statusText,
        headers,
      }), response);
    } catch (error) {
      log("Fetch filter left original response intact:", error);
      return response;
    }
  };

  /**********************
   * XHR INTERCEPT
   **********************/
  // Keep the native constructor, constants, prototype and event dispatch intact.
  // Native response getters work for onload AND addEventListener consumers and
  // respect responseType. A readystatechange wrapper cannot guarantee this.
  const prototype = window.XMLHttpRequest.prototype;
  const requests = new WeakMap();
  const realOpen = prototype.open;
  const textDescriptor = Object.getOwnPropertyDescriptor(prototype, "responseText");
  const responseDescriptor = Object.getOwnPropertyDescriptor(prototype, "response");

  function filteredXhrResponse(xhr, raw) {
    const request = requests.get(xhr);
    if (!request?.kind || xhr.readyState !== 4 || xhr.status < 200 || xhr.status >= 300 ||
        !isJson(xhr.getResponseHeader("content-type"))) return raw;
    if (request.cached && request.raw === raw) return request.filtered;
    let filtered = raw;
    try {
      if (typeof raw === "string") filtered = filterText(raw, request.kind);
      else if (xhr.responseType === "json" && raw && typeof raw === "object") {
        const copy = JSON.parse(JSON.stringify(raw));
        if (scrubJson(copy, request.kind)) filtered = copy;
      }
    } catch (error) {
      log("XHR filter left original response intact:", error);
    }
    request.raw = raw;
    request.filtered = filtered;
    request.cached = true;
    return filtered;
  }

  // If a browser does not permit getter interception, leave XHR untouched.
  if (textDescriptor?.get && responseDescriptor?.get &&
      textDescriptor.configurable && responseDescriptor.configurable) {
    prototype.open = function(method, url) {
      requests.set(this, { kind: endpointKind(url), cached: false });
      return realOpen.apply(this, arguments);
    };
    Object.defineProperty(prototype, "responseText", {
      ...textDescriptor,
      get() { return filteredXhrResponse(this, textDescriptor.get.call(this)); },
    });
    Object.defineProperty(prototype, "response", {
      ...responseDescriptor,
      get() { return filteredXhrResponse(this, responseDescriptor.get.call(this)); },
    });
  }

  log("Loaded. Filtering recognized feed collections only.");
})();
